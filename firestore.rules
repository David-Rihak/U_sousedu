rules_version = '2';

// Security rules for the U sousedů app (see C:\Work\TP\datovy_model.txt).
// Deployed by hand: Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
// Roles live in users/{uid}.role ("CUSTOMER" | "ADMIN" | "OWNER") and can only be changed
// in the Console (the Console / Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Staff = ADMIN or OWNER. A user without a users/{uid} document is never staff.
    function isStaff() {
      return isSignedIn()
        && exists(userDoc())
        && get(userDoc()).data.get('role', 'CUSTOMER') in ['ADMIN', 'OWNER'];
    }

    // ---------- users ----------

    match /users/{userId} {
      // Own profile; staff may read customers (e-mail is shown on the staff screen).
      allow read: if isOwner(userId) || isStaff();

      // Created at registration (email, role, createdAt) or by the first favorite-café
      // change of an account created in the Console. Never with a staff role.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'favoriteCafeId'])
        && request.resource.data.get('role', 'CUSTOMER') == 'CUSTOMER';

      // The user may change only the favorite café; role and e-mail stay untouched.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCafeId'])
        && request.resource.data.favoriteCafeId is string;

      allow delete: if false;
    }

    // ---------- public catalog (read by every signed-in user) ----------

    match /cafes/{cafeId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ---------- loyalty cards (one per user, the whole network) ----------

    function isValidCard(card) {
      return card.keys().hasOnly(['stamps', 'stampsGoal', 'updatedAt'])
        && card.stamps is int
        && card.stampsGoal is int
        && card.stampsGoal > 0
        && card.stamps >= 0
        && card.stamps <= card.stampsGoal;
    }

    match /loyaltyCards/{userId} {
      // A customer only reads their own card; stamps are changed by staff only.
      allow read: if isOwner(userId) || isStaff();
      allow create, update: if isStaff() && isValidCard(request.resource.data);
      allow delete: if false;

      // Audit log of stamps and redeemed rewards: append-only, written by staff.
      match /history/{entryId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isStaff()
          && request.resource.data.staffId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Everything else is denied by default.
  }
}
